# Server config — copy to .env and fill in (never commit .env)
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/shopwise_vouchers
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Seed credentials (optional overrides — never commit real values)
# SEED_ADMIN_EMAIL=admin@shopwise.mw
# SEED_ADMIN_PASSWORD=
# SEED_MANAGER_EMAIL=manager@shopwise.mw
# SEED_MANAGER_PASSWORD=
# SEED_CASHIER_EMAIL=cashier@shopwise.mw
# SEED_CASHIER_PASSWORD=
# SEED_AUDITOR_EMAIL=auditor@shopwise.mw
# SEED_AUDITOR_PASSWORD=

# Free email alerts (Gmail app password ~500/day, or Brevo free tier).
# Leave unset to run without email — attempts are logged, nothing breaks.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=Vouchera <you@gmail.com>

# Africa's Talking SMS (pay-as-you-go; sandbox username is free for testing).
# Leave unset to run without SMS.
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SENDER=
