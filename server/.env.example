# Server config — copy to .env and fill in (never commit .env)
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/shopwise_vouchers
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

